# Version control and IDE files
.git/
.gitignore
.vscode/
.github/
# Application folder (frontend/backend node_modules, etc.)
app/


# Experiment outputs and logs (exclusively kept inside containers at runtime)
log/
log_tensorboard/
results/


# Heavy raw datasets and archives (not needed for running preprocessed experiments)
dataset_raw/
dataset_temp/
RecBole.zip

# Python temporary files, caches, and build directories
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/
.env

# Model checkpoints: exclude all except GRU4Rec, GRU4RecF, and NARM
saved/*
!saved/GRU4Rec*
!saved/GRU4RecF*
!saved/NARM*

